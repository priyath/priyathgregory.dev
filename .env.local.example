# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Keystatic CMS — GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL: https://priyathgregory.dev
# Authorization callback URL: https://keystatic.cloud/oauth/callback/github
KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Keystatic secret — random string, used to sign session cookies
# Generate with: openssl rand -hex 32
KEYSTATIC_SECRET=your_random_secret_string
